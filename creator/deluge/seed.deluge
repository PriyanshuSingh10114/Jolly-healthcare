		];
	}
	else
	{
		plantId = plants.ID;
	}
	if(Formulations[Masked_Node_ID == node].count() == 0)
	{
		insert into Formulations
		[
			Added_User = zoho.loginuser
			Plant_Reference = plantId
			Masked_Node_ID = node
